	"mnemopi": {
		"api": "http://127.0.0.1:11434",
		"model": "embeddinggemma-2:270m",
		"settings": {
			"memory.backend": "mnemopi",
			"mnemopi.embeddingModel": "embeddinggemma-2:270m",
			"mnemopi.embeddingApiUrl": "http://127.0.0.1:11434/v1",
			"mnemopi.embeddingApiKey": "ollama"
		},
		"install": [
			"brew install ollama",
			"brew services start ollama",
			"ollama pull embeddinggemma-2:270m"
		],
		"verify": "POST http://127.0.0.1:11434/v1/embeddings with the configured model and one input"
	},
	"configFallback": "config.yaml"
